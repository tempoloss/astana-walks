bgo-eiu/subscriptions","organizations_url":"https://api.github.com/users/bgo-eiu/orgs","repos_url":"https://api.github.com/users/bgo-eiu/repos","events_url":"https://api.github.com/users/bgo-eiu/events{/privacy}","received_events_url":"https://api.github.com/users/bgo-eiu/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":401890166,"node_id":"MDU6TGFiZWw0MDE4OTAxNjY=","url":"https://api.github.com/repos/streetcomplete/StreetComplete/labels/wontfix","name":"wontfix","color":"e6e6e6","default":true,"description":"idea rejected because it is out of scope or because required work is not matching expected benefits","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2022-03-27T19:19:44Z","updated_at":"2023-07-19T14:10:26Z","closed_at":"2022-03-28T13:03:43Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"**Use case**\r\n<!-- Provide a clear and concise description of *your use case* and what you thus think is missing, and why. -->\r\nOften, eyeballing street light poles during daylight hours isn't a great way to answer questions such as \"Is this stretch of way lit?\" or \"Is this bus stop lit?\" If you choose not to answer these during the day, these quests contribute to visual clutter, and while turning them on and off or using a preset is an option it is a bit unwieldy since you would have to remember to switch it and the lighting questions are spread between multiple quests.\r\n\r\n**Proposed Solution**\r\nThere could be a check/toggle box in the settings for this. I think this might be fairly straightforward to implement given that StreetComplete already switches the rendering theme based on day time or night time; this feature would do the same thing but for whether or not lighting prelates quests get shown.\r\n","reactions":{"url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/3925/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/3925/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4629","repository_url":"https://api.github.com/repos/streetcomplete/StreetComplete","labels_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4629/labels{/name}","comments_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4629/comments","events_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4629/events","html_url":"https://github.com/streetcomplete/StreetComplete/issues/4629","id":1446495639,"node_id":"I_kwDOA7jats5WN8WX","number":4629,"title":"Too low contrast in street lighting overlay for \"no data\" ways","user":{"login":"ahstro","id":3090888,"node_id":"MDQ6VXNlcjMwOTA4ODg=","avatar_url":"https://avatars.githubusercontent.com/u/3090888?v=4","gravatar_id":"","url":"https://api.github.com/users/ahstro","html_url":"https://github.com/ahstro","followers_url":"https://api.github.com/users/ahstro/followers","following_url":"https://api.github.com/users/ahstro/following{/other_user}","gists_url":"https://api.github.com/users/ahstro/gists{/gist_id}","starred_url":"https://api.github.com/users/ahstro/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ahstro/subscriptions","organizations_url":"https://api.github.com/users/ahstro/orgs","repos_url":"https://api.github.com/users/ahstro/repos","events_url":"https://api.github.com/users/ahstro/events{/privacy}","received_events_url":"https://api.github.com/users/ahstro/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":401890160,"node_id":"MDU6TGFiZWw0MDE4OTAxNjA=","url":"https://api.github.com/repos/streetcomplete/StreetComplete/labels/bug","name":"bug","color":"ee0701","default":true,"description":null,"archived_at":null,"archived_by":null},{"id":401890161,"node_id":"MDU6TGFiZWw0MDE4OTAxNjE=","url":"https://api.github.com/repos/streetcomplete/StreetComplete/labels/duplicate","name":"duplicate","color":"cccccc","default":true,"description":null,"archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":4,"created_at":"2022-11-12T15:32:53Z","updated_at":"2024-03-15T13:34:16Z","closed_at":"2022-11-12T16:17:51Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<!-- \r\nPlease provide a clear and concise description of the bug. \r\n\r\nMaybe it is not a bug? Check the FAQ: https://wiki.openstreetmap.org/wiki/StreetComplete/FAQ\r\n-->\r\nWhen using the street lighting overlay, it is really difficult to make out which segment is selected when selecting unmapped ways.\r\n\r\nZoomed out:\r\n![Screenshot_20221112-162543_Street­Complete](https://user-images.githubusercontent.com/3090888/201481479-a394a9ef-79e7-4bd2-955a-554d155d96d1.png)\r\n\r\nZoomed in:\r\n![Screenshot_20221112-162528_Street­Complete](https://user-images.githubusercontent.com/3090888/201481483-a3a80c24-f24f-4098-b14e-493f01d2508f.png)\r\n\r\n\r\n**How to Reproduce**\r\n<!-- Add steps to reproduce this behavior here -->\r\n1. Enable the street lighting overlay\r\n2. Press an unmapped (red) way\r\n3. Have difficulty seeing where the segment starts/ends\r\n\r\n**Expected Behavior**\r\n<!-- Add a clear and concise description of what you expected to happen -->\r\nUse a color with higher contrast, so the selected segment is more easily spotted\r\n\r\n**Versions affected**\r\n<!-- Add the Android and StreetComplete version here. Please use exact version number instead of saying \"latest\" -->\r\n49.0","reactions":{"url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4629/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4629/timeline","performed_via_github_app":null,"state_reason":"not_planned","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4631","repository_url":"https://api.github.com/repos/streetcomplete/StreetComplete","labels_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4631/labels{/name}","comments_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4631/comments","events_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4631/events","html_url":"https://github.com/streetcomplete/StreetComplete/issues/4631","id":1448380375,"node_id":"I_kwDOA7jats5WVIfX","number":4631,"title":"Street lighting overlay visibility issue (selection in overlays works poorly on data missing ways, especially in night mode)","user":{"login":"thefirethirteen","id":78559591,"node_id":"MDQ6VXNlcjc4NTU5NTkx","avatar_url":"https://avatars.githubusercontent.com/u/78559591?v=4","gravatar_id":"","url":"https://api.github.com/users/thefirethirteen","html_url":"https://github.com/thefirethirteen","followers_url":"https://api.github.com/users/thefirethirteen/followers","following_url":"https://api.github.com/users/thefirethirteen/following{/other_user}","gists_url":"https://api.github.com/users/thefirethirteen/gists{/gist_id}","starred_url":"https://api.github.com/users/thefirethirteen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/thefirethirteen/subscriptions","organizations_url":"https://api.github.com/users/thefirethirteen/orgs","repos_url":"https://api.github.com/users/thefirethirteen/repos","events_url":"https://api.github.com/users/thefirethirteen/events{/privacy}","received_events_url":"https://api.github.com/users/thefirethirteen/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":401890160,"node_id":"MDU6TGFiZWw0MDE4OTAxNjA=","url":"https://api.github.com/repos/streetcomplete/StreetComplete/labels/bug","name":"bug","color":"ee0701","default":true,"description":null,"archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":3,"created_at":"2022-11-14T16:32:54Z","updated_at":"2024-03-15T13:33:47Z","closed_at":"2022-11-14T16:45:11Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<!-- \nWhen using the Street lighting overlay, streets which have no such data appear as red in both light and dark mode.\nBut at the same time, a selected portion of a street is highlighted using a very similar shade of red, making it hard to distinguish which portion of a street is selected when there are other portions of the same street, also in red next to it.\n-->\n\n**How to Reproduce**\n1. Hamburger menu > Overlays > Street lighting > OK\n2. Choose any street that is red.\n\n**Expected Behavior**\nThe user should be able to clearly distinguish the selected portion without street lighting data from other portions of the same street which also don't have street lighting data.\n\n**Versions affected**\nStreetComplete v49.0\nAndroid 11\n\n**Screenshots**\nA portion that is NOT selected.\n![Screenshot_20221114-181332_1.png](https://user-images.githubusercontent.com/78559591/201713651-d4cb24ab-ba9b-46a9-b8f8-ce5611b3636d.png)\n\nThe same portion, but is selected.\n![Screenshot_20221114-181340_1.png](https://user-images.githubusercontent.com/78559591/201713940-3563722a-06bd-41bf-9f1a-f3bb3638abd6.png)\n\nThe same portion, selected, zoomed out.\n![Screenshot_20221114-181353_1.png](https://user-images.githubusercontent.com/78559591/201714027-b66c29a5-bbd4-4879-bb6a-48cb2e274a07.png)\n\nAnother street that is lit and selected, showing how easily you should be able to distinguish a non-selected portion from a selected one.\n![Screenshot_20221114-181459_1.png](https://user-images.githubusercontent.com/78559591/201714214-ce44ee06-b338-44d7-977b-0473dcce117b.png)","reactions":{"url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4631/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4631/timeline","performed_via_github_app":null,"state_reason":"not_planned","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4121","repository_url":"https://api.github.com/repos/streetcomplete/StreetComplete","labels_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4121/labels{/name}","comments_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4121/comments","events_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4121/events","html_url":"https://github.com/streetcomplete/StreetComplete/issues/4121","id":1272145692,"node_id":"I_kwDOA7jats5L02cc","number":4121,"title":"Street lighting layer allows tagging ALL highways","user":{"login":"HolgerJeromin","id":2410353,"node_id":"MDQ6VXNlcjI0MTAzNTM=","avatar_url":"https://avatars.githubusercontent.com/u/2410353?v=4","gravatar_id":"","url":"https://api.github.com/users/HolgerJeromin","html_url":"https://github.com/HolgerJeromin","followers_url":"https://api.github.com/users/HolgerJeromin/followers","following_url":"https://api.github.com/users/HolgerJeromin/following{/other_user}","gists_url":"https://api.github.com/users/HolgerJeromin/gists{/gist_id}","starred_url":"https://api.github.com/users/HolgerJeromin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/HolgerJeromin/subscriptions","organizations_url":"https://api.github.com/users/HolgerJeromin/orgs","repos_url":"https://api.github.com/users/HolgerJeromin/repos","events_url":"https://api.github.com/users/HolgerJeromin/events{/privacy}","received_events_url":"https://api.github.com/users/HolgerJeromin/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2022-06-15T12:15:37Z","updated_at":"2022-06-15T12:27:24Z","closed_at":"2022-06-15T12:26:53Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Perhaps not really a bug. But at least this differs from streetlighting to sidewalks. \r\n`living_streets` are not shown/asked for sidewalks.\r\n\r\nWith lighting I am \"supposed\" to add lit to \"every\" highway. But currently `service=driveways` are excluded in the normal quests.\r\n","reactions":{"url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4121/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/streetcomplete/StreetComplete/issues/4121/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0}],"search_type":"lexical"}