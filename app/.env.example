# Copy to .env.<name> and start with WALKS_ENV=<name> (e.g. `.env.demo`, git-ignored); or export the variables.
# Variables already set in the shell win over the file.

# --- Google AI Studio (provider `gemini`) -------------------------------------------------------------
# GEMINI_API_KEY=...            # else the first line of GEMINI_KEY_FILE, else <Hackathons>/.gemini-key
# GEMINI_KEY_FILE=/path/to/file

# --- chains: comma-separated `provider:model[@profile]`, first link first ----------------------------------
# Defaults (Google only) are in walks/llm.py:
#   LLM_CHAIN        gemini:gemini-3.5-flash,gemini:gemini-flash-latest,gemini:gemini-2.5-flash,
#                    gemini:gemma-4-26b-a4b-it
#   LLM_INTENT_CHAIN gemini:gemini-2.5-flash-lite,gemini:gemini-3.5-flash-lite,gemini:gemma-4-26b-a4b-it
# Providers: `gemini` (google-genai) and `openai` (any OpenAI-compatible /chat/completions).
# A link that fails (HTTP error, timeout, answer that is not valid JSON for the schema) hands over to the next one.
# LLM_CHAIN=gemini:gemini-3.5-flash,gemini:gemma-4-26b-a4b-it,openai:<model>@<profile>
# LLM_INTENT_CHAIN=gemini:gemini-2.5-flash-lite,openai:<model>@<profile>

# --- OpenAI-compatible profile: `openai:<model>@<NAME>` reads LLM_PROFILE_<NAME>_* ------------------------------
# Public AlemLLM API (profile `alem`): the base URL https://llm.alem.ai/v1 is built in, only the key is needed.
# Models: alemllm, gemma4.  LLM_CHAIN=gemini:gemini-3.5-flash,openai:alemllm@alem,openai:gemma4@alem
# LLM_PROFILE_ALEM_API_KEY_FILE=/path/to/alem-key     # first line is the key; or LLM_PROFILE_ALEM_API_KEY=...
# scripts/warm_cache.py records through public links only (gemini:* and openai:*@alem), never through a profile below.
#
# Any other OpenAI-compatible endpoint is a generic named profile; a private gateway is just such an example:
# LLM_CHAIN=...,openai:<model-id>@gw
# LLM_PROFILE_GW_BASE_URL=https://<your-gateway-host>/v1
# LLM_PROFILE_GW_API_KEY_FILE=/path/to/token-file     # first line is the key; or LLM_PROFILE_GW_API_KEY=...
# LLM_PROFILE_GW_JSON_MODE=json_object                # json_object (default) | json_schema | none
# LLM_PROFILE_GW_CA_FILE=/path/to/ca.pem              # only for a private CA; the OS trust store is used by default
# Without a profile, `openai:<model>` uses OPENAI_BASE_URL (default https://api.openai.com/v1) and OPENAI_API_KEY.

# --- modes ---------------------------------------------------------------------------------------------
# WALKS_ENV=demo               # load app/.env.demo
# WALKS_OFFLINE=1              # no network at all: template text, unknown weather, cached/straight walking legs
# WALKS_SIMULATE_GOOGLE_DOWN=1 # every gemini link fails (same as CLI --simulate-google-down)
# WALKS_LLM_CACHE=off          # response cache path; `off` disables it
# WALKS_CACHE_PIN=1            # demo replay: cache key = scenario cell + intent + candidate ids (no 30-min bucket, no chain)
# WALKS_DEMO_PIN=1             # demo preset, ONLY for the recorded demo requests (scenario tiles, presets.DEMO_REQUESTS and the
#                              # follow-ups of their dialogue): fixed time per scenario, manual weather (normal; cold/smog
#                              # scenario -25 C / PM2.5 80), walking legs from the shipped data/walk_cache.json (no network),
#                              # marks from the tracked seed data/city_feedback.json (visitors' marks never change them). Any other request is
#                              # answered at the real time with the live weather. scripts/warm_cache.py records through the
#                              # same code, so the recording matches the stage exactly
# WALKS_DEMO_CACHE=off         # recorded answers read under WALKS_ENV=demo (default data/demo_llm_cache.json); `off` or a path
#                              # a demo accelerator only: the offline guarantee is the template path, not this cache
# WALKS_REPLAY_ONLY=1          # recorded answers only (the jury's offline run; the public stand does not set it and calls its
#                              # model chain for a request outside the recording): recorded answers are served (needs
#                              # WALKS_ENV=demo + WALKS_CACHE_PIN=1 for data/demo_llm_cache.json), no model is ever called, a
#                              # request that is not in the recording gets the template text; sidebar: «ИИ: только записанные ответы демо»

# --- data ---------------------------------------------------------------------------------------------
# POI_PATH=../data/poi.enriched.json   # shipped base (default); OSM-only baseline: ../data/poi.json
# WALKS_FEEDBACK=.local/city_feedback.json   # working file of people's marks (default app/.local/city_feedback.json,
#                              # git-ignored, copied from the tracked seed ../data/city_feedback.json on first use; a clone
#                              # is never dirtied by clicks). `off`: marks are neither read nor written.
